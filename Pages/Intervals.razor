@page "/intervals"
@implements IDisposable
@inject IntervalTimer Timer

<PageTitle>Intervals · jtimer</PageTitle>

<section class="interval-page">
    <div class="interval-card" data-phase="@Timer.Phase.ToString().ToLowerInvariant()">
        <header class="interval-header">
            <h1 class="screen-title">Intervals</h1>
            <p class="interval-summary">@WorkoutSummary</p>
        </header>

        <div class="phase-card">
            <p class="phase-label" aria-live="polite" aria-atomic="true">@PhaseTitle</p>
            <div class="interval-ring">
                <svg class="interval-ring-svg" viewBox="0 0 240 240" aria-hidden="true">
                    <circle class="interval-ring-track" cx="120" cy="120" r="104" />
                    <circle class="interval-ring-progress" cx="120" cy="120" r="104"
                            style="stroke-dasharray: @RingDashArray; stroke-dashoffset: @RingDashOffset" />
                </svg>
                <div class="interval-countdown" role="timer" aria-live="off"
                     aria-label="@PhaseTitle: @DisplayTime remaining">
                    @DisplayTime
                </div>
            </div>
            <p class="phase-hint">@PhaseHint</p>

        </div>

        <div class="session-progress" role="group" aria-label="Workout session progress">
            <div class="session-progress-track" role="progressbar" aria-label="Overall workout progress"
                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="@SessionProgressPercent">
                @for (var index = 0; index < SessionSegments.Count; index++)
                {
                    var segment = SessionSegments[index];
                    <span class="session-segment @segment.CssClass @GetSegmentState(index)"
                          style="width: @segment.WidthPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"
                          title="@segment.Label"></span>
                }
                <span class="session-progress-cursor" style="left: @SessionProgressPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
            </div>
            <div class="session-progress-labels" aria-hidden="true">
                @for (var round = 1; round <= Timer.TotalRounds; round++)
                {
                    <span class="session-round @(GetRoundState(round))"
                          style="left: @RoundLabelPosition(round).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">@round</span>
                }
            </div>
            <p class="session-progress-caption">Round @DisplayedRound of @Timer.TotalRounds</p>
        </div>

        @if (Timer.Phase is not IntervalPhase.Finished)
        {
            <div class="next-phase" aria-label="Next interval">
                <span class="next-phase-label">UP NEXT</span>
                <span class="next-phase-name">@NextPhaseTitle</span>
                <span class="next-phase-duration">@NextPhaseDuration</span>
            </div>
        }
        else
        {
            <div class="workout-complete" role="status">All @Timer.TotalRounds rounds complete. Great work!</div>
        }

        <div class="interval-actions">
            @if (Timer.IsRunning)
            {
                <button type="button" class="interval-button interval-button-primary" @onclick="Timer.PauseAsync">
                    Pause
                </button>
            }
            else if (Timer.IsPaused)
            {
                <button type="button" class="interval-button interval-button-primary" @onclick="Timer.ResumeAsync">
                    Resume
                </button>
            }
            else
            {
                <button type="button" class="interval-button interval-button-primary" @onclick="Timer.StartAsync">
                    @(Timer.Phase == IntervalPhase.Finished ? "Start again" : "Start workout")
                </button>
            }

            <button type="button" class="interval-button interval-button-secondary"
                    disabled="@(Timer.Phase == IntervalPhase.Ready)" @onclick="Timer.ResetAsync">
                Reset
            </button>
        </div>
    </div>
</section>

@code {
    private const double RingRadius = 104;
    private const double RingCircumference = 2 * Math.PI * RingRadius;

    private IntervalSettings cachedSettings = IntervalSettings.Default;
    private IReadOnlyList<SessionSegment>? cachedSegments;

    private string DisplayTime
    {
        get
        {
            var totalSeconds = (int)Math.Ceiling(Timer.Remaining.TotalSeconds);
            return $"{totalSeconds / 60:00}:{totalSeconds % 60:00}";
        }
    }

    private int PhaseProgressPercent =>
        Timer.PhaseDuration <= TimeSpan.Zero
            ? 0
            : (int)Math.Round((Timer.Remaining / Timer.PhaseDuration) * 100);

    private double RingDashOffset => RingCircumference * (1 - (PhaseProgressPercent / 100d));

    private string RingDashArray => RingCircumference.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private double TotalSessionSeconds => Math.Max(Timer.TotalSessionDuration.TotalSeconds, 1);

    private string WorkoutSummary =>
        $"{Timer.TotalRounds} rounds · " +
        $"{DurationText.FromSeconds(Timer.Settings.ExerciseSeconds)} exercise · " +
        $"{DurationText.FromSeconds(Timer.Settings.RestSeconds)} rest";

    private string PhaseTitle => Timer.Phase switch
    {
        IntervalPhase.Prepare => "Get ready",
        IntervalPhase.Exercise => "Exercise",
        IntervalPhase.Rest => "Rest",
        IntervalPhase.Finished => "Workout complete",
        _ => "Ready when you are"
    };

    private string PhaseHint => Timer.Phase switch
    {
        IntervalPhase.Prepare => "Find your position · exercise starts next",
        IntervalPhase.Exercise => $"Round {Timer.CurrentRound} of {Timer.TotalRounds} · keep moving!",
        IntervalPhase.Rest => $"Recover · round {Timer.CurrentRound + 1} starts next",
        IntervalPhase.Finished => "You finished every round.",
        _ => $"{DurationText.FromSeconds(Timer.Settings.PrepareSeconds)} prepare · " +
             $"{DurationText.FromSeconds(Timer.Settings.ExerciseSeconds)} exercise · " +
             $"{DurationText.FromSeconds(Timer.Settings.RestSeconds)} rest"
    };

    private string NextPhaseTitle => Timer.Phase switch
    {
        IntervalPhase.Ready => "Prepare",
        IntervalPhase.Prepare => "Exercise",
        IntervalPhase.Exercise when Timer.CurrentRound < Timer.TotalRounds => "Rest",
        IntervalPhase.Exercise => "Finish",
        IntervalPhase.Rest => "Exercise",
        _ => string.Empty
    };

    private string NextPhaseDuration => Timer.Phase switch
    {
        IntervalPhase.Ready => DurationText.FromSeconds(Timer.Settings.PrepareSeconds),
        IntervalPhase.Prepare => DurationText.FromSeconds(Timer.Settings.ExerciseSeconds),
        IntervalPhase.Exercise when Timer.CurrentRound < Timer.TotalRounds =>
            DurationText.FromSeconds(Timer.Settings.RestSeconds),
        IntervalPhase.Rest => DurationText.FromSeconds(Timer.Settings.ExerciseSeconds),
        _ => string.Empty
    };

    protected override async Task OnInitializedAsync()
    {
        Timer.Changed += OnTimerChanged;
        await Timer.EnsureSettingsAsync();
    }

    private double SessionElapsedSeconds
    {
        get
        {
            var settings = Timer.Settings;
            var roundLengthSeconds = settings.ExerciseSeconds + settings.RestSeconds;
            var remainingSeconds = Timer.Remaining.TotalSeconds;
            var roundStartSeconds = settings.PrepareSeconds + ((Timer.CurrentRound - 1) * roundLengthSeconds);

            return Timer.Phase switch
            {
                IntervalPhase.Ready => 0,
                IntervalPhase.Prepare => settings.PrepareSeconds - remainingSeconds,
                IntervalPhase.Exercise => roundStartSeconds + settings.ExerciseSeconds - remainingSeconds,
                IntervalPhase.Rest => roundStartSeconds + settings.ExerciseSeconds + settings.RestSeconds - remainingSeconds,
                IntervalPhase.Finished => TotalSessionSeconds,
                _ => 0
            };
        }
    }

    private double SessionProgressPercent => Math.Clamp(SessionElapsedSeconds / TotalSessionSeconds * 100, 0, 100);

    private int DisplayedRound => Timer.Phase == IntervalPhase.Rest
        ? Math.Min(Timer.CurrentRound + 1, Timer.TotalRounds)
        : Math.Min(Timer.CurrentRound, Timer.TotalRounds);

    private double RoundLabelPosition(int round)
    {
        var settings = Timer.Settings;
        var roundLengthSeconds = settings.ExerciseSeconds + settings.RestSeconds;
        var roundCenterSeconds =
            settings.PrepareSeconds + ((round - 1) * roundLengthSeconds) + (settings.ExerciseSeconds / 2d);

        return roundCenterSeconds / TotalSessionSeconds * 100;
    }

    // Exactly one segment is current: the one the session clock sits inside.
    private int ActiveSegmentIndex
    {
        get
        {
            if (Timer.Phase == IntervalPhase.Ready)
            {
                return -1;
            }

            if (Timer.Phase == IntervalPhase.Finished)
            {
                return SessionSegments.Count;
            }

            var elapsedSeconds = SessionElapsedSeconds;
            var accumulatedSeconds = 0d;
            for (var index = 0; index < SessionSegments.Count; index++)
            {
                accumulatedSeconds += SessionSegments[index].DurationSeconds;
                if (elapsedSeconds < accumulatedSeconds)
                {
                    return index;
                }
            }

            return SessionSegments.Count;
        }
    }

    // Rebuilt only when the configured durations change, not on every tick.
    private IReadOnlyList<SessionSegment> SessionSegments
    {
        get
        {
            if (cachedSegments is null || cachedSettings != Timer.Settings)
            {
                cachedSettings = Timer.Settings;
                cachedSegments = BuildSessionSegments(cachedSettings);
            }

            return cachedSegments;
        }
    }

    private static IReadOnlyList<SessionSegment> BuildSessionSegments(IntervalSettings settings)
    {
        var totalSeconds = Math.Max(settings.TotalDuration.TotalSeconds, 1);
        var segments = new List<SessionSegment>
        {
            new("Prepare", "prepare", settings.PrepareSeconds, totalSeconds)
        };

        for (var round = 1; round <= settings.Rounds; round++)
        {
            segments.Add(new($"Round {round} exercise", "exercise", settings.ExerciseSeconds, totalSeconds));

            if (round < settings.Rounds)
            {
                segments.Add(new($"Round {round} rest", "rest", settings.RestSeconds, totalSeconds));
            }
        }

        return segments;
    }

    private string GetSegmentState(int index)
    {
        var activeIndex = ActiveSegmentIndex;
        if (activeIndex < 0)
        {
            return "upcoming";
        }

        if (index == activeIndex)
        {
            return "active";
        }

        return index < activeIndex ? "complete" : "upcoming";
    }

    private string GetRoundState(int round)
    {
        if (Timer.Phase == IntervalPhase.Finished ||
            (Timer.Phase == IntervalPhase.Exercise && round < Timer.CurrentRound) ||
            (Timer.Phase == IntervalPhase.Rest && round <= Timer.CurrentRound))
        {
            return "complete";
        }

        var activeRound = Timer.Phase == IntervalPhase.Rest
            ? Timer.CurrentRound + 1
            : Timer.CurrentRound;

        return round == activeRound
            ? "current"
            : "upcoming";
    }

    private void OnTimerChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Timer.Changed -= OnTimerChanged;
    }

    private sealed record SessionSegment(
        string Label,
        string CssClass,
        double DurationSeconds,
        double TotalSessionSeconds)
    {
        public double WidthPercent => DurationSeconds / TotalSessionSeconds * 100;
    }
}
