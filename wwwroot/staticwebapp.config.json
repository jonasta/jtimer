{
  "routes": [
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/service-worker.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/service-worker-assets.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "*.{css,scss,js,png,jpg,jpeg,gif,svg,ico,webp,json,wasm,dll,woff,woff2}",
      "/_framework/*"
    ]
  }
}
